# Copy to .env on the deployment host and replace placeholders locally.
# Never commit the populated file or either secret file.

MLFLOW_BACKEND_DB_NAME=<required-mlflow-backend-database>
MLFLOW_BACKEND_DB_USER=<required-mlflow-backend-user>
MLFLOW_BACKEND_DB_PASSWORD_SECRET_FILE=/absolute/path/to/mlflow_backend_password
REGIME_FEATURE_PGDATABASE=<required-regime-loader-serving-database>
REGIME_FEATURE_PGPASSWORD_SECRET_FILE=/absolute/path/to/regime_feature_password

# Persistent local MLflow state. These host directories are bind-mounted; do
# not point them at a network share or a path outside the deployment host.
MLFLOW_ARTIFACTS_HOST_PATH=/volume2/docker/mlflow/artifacts
MLFLOW_BACKEND_DATA_HOST_PATH=/volume2/docker/mlflow/postgres

# Bind mounts on NAS hosts can enforce host ACLs. Set these to the local host
# account that owns the MLflow directory (for example 1016 and 100); retain
# the image defaults when the host filesystem accepts the container UIDs.
MLFLOW_RUNTIME_UID=10001
MLFLOW_RUNTIME_GID=10001
MLFLOW_POSTGRES_RUNTIME_UID=70
MLFLOW_POSTGRES_RUNTIME_GID=70

# Canonical feature source identity; this trusted-LAN server does not offer TLS.
REGIME_FEATURE_PGHOST=10.10.1.3
REGIME_FEATURE_PGPORT=54321
REGIME_FEATURE_PGUSER=regime-engine
REGIME_FEATURE_PGSSLMODE=disable

# Single trusted-LAN MLflow endpoint. Add only explicitly trusted hostnames/origins.
MLFLOW_SERVER_ALLOWED_HOSTS=10.10.1.3,localhost,127.0.0.1
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=http://10.10.1.3:5000,http://localhost:5000,http://127.0.0.1:5000

# Exact production concurrency/resource defaults.
MLFLOW_WORKERS=4
MLFLOW_THREADS_PER_WORKER=4
MLFLOW_HTTP_TIMEOUT_SECONDS=120
MLFLOW_GRACEFUL_TIMEOUT_SECONDS=30
REGIME_MODEL_ALIAS_CACHE_TTL_SECONDS=30
REGIME_PG_POOL_MIN_SIZE=1
REGIME_PG_POOL_MAX_SIZE=4
REGIME_PG_ACQUIRE_TIMEOUT_SECONDS=5
REGIME_PG_STATEMENT_TIMEOUT_SECONDS=30
REGIME_FEATURE_PG_CONNECTION_BUDGET=16
REGIME_REPLAY_MAX_ROWS=10000
REGIME_REPLAY_MAX_INTERNAL_ROWS=15000
REGIME_REPLAY_MAX_RANGE_DAYS=14610
REGIME_REPLAY_TIMEOUT_SECONDS=60
REGIME_REPLAY_MAX_RESPONSE_BYTES=26214400
REGIME_REPLAY_MAX_CONCURRENCY_PER_WORKER=1
REGIME_SOURCE_STALE_WARN_DAYS=4
REGIME_SOURCE_STALE_FAIL_DAYS=7
REGIME_MODEL_STALE_WARN_DAYS=14
REGIME_MODEL_STALE_FAIL_DAYS=35
