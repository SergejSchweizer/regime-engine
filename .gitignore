# Python virtual environment
.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, linter, dependency, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Local environment files and secrets
.env
.env.*
!.env.example
config.yaml
secrets/
*.pem
*.key
*.crt

# Local MLflow state / artifacts
mlruns/
mlartifacts/
.mlflow/
mlflow/

# Local engine output and generated prediction data
artifacts/
predictions/
output/
outputs/
evaluations/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# IDE/editor-local metadata
.idea/
.vscode/

# OS-generated metadata
.DS_Store
Thumbs.db
Desktop.ini
